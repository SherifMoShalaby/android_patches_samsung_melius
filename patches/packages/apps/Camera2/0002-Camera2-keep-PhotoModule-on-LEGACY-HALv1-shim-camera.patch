From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sherif Shalaby <sherif2222222@gmail.com>
Date: Wed, 14 Oct 2026 19:18:23 +0300
Subject: [PATCH 2/2] Camera2: keep PhotoModule on LEGACY (HALv1 shim) cameras

With the camera2 legacy shim restored, HALv1 cameras report
INFO_SUPPORTED_HARDWARE_LEVEL_LEGACY instead of failing. Camera1 is the
native path for them, so keep using PhotoModule.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I53b7d7c406c6ddd5e9c4278f126358e32284d57d
---
 .../camera/one/config/OneCameraFeatureConfigCreator.java  | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/src/com/android/camera/one/config/OneCameraFeatureConfigCreator.java b/src/com/android/camera/one/config/OneCameraFeatureConfigCreator.java
index 4f75554..949fc61 100644
--- a/src/com/android/camera/one/config/OneCameraFeatureConfigCreator.java
+++ b/src/com/android/camera/one/config/OneCameraFeatureConfigCreator.java
@@ -48,7 +48,13 @@ public class OneCameraFeatureConfigCreator {
         try {
             CameraManager cameraManager = context.getSystemService(CameraManager.class);
             for (String id : cameraManager.getCameraIdList()) {
-                cameraManager.getCameraCharacteristics(id);
+                Integer level = cameraManager.getCameraCharacteristics(id)
+                        .get(CameraCharacteristics.INFO_SUPPORTED_HARDWARE_LEVEL);
+                // HALv1 behind the camera2 legacy shim: camera1 is the native, faster path
+                if (level != null
+                        && level == CameraCharacteristics.INFO_SUPPORTED_HARDWARE_LEVEL_LEGACY) {
+                    useCaptureModule = false;
+                }
             }
         } catch (Exception e) {
             useCaptureModule = false;
