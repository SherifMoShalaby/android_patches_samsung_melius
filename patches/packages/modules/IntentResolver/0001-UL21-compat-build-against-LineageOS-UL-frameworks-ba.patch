From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sherif Shalaby <sherif2222222@gmail.com>
Date: Wed, 14 Oct 2026 00:39:03 +0300
Subject: [PATCH] UL21 compat: build against LineageOS-UL frameworks/base
 (2025-04-04)

Drop the app half of 2025-26 security changes whose framework API UL never
merged. Revert when frameworks/base
gets those backports.

Change-Id: Ib301710ef59118ef6ba9cfc5b35aa01d5dd1c568
---
 .../com/android/intentresolver/IntentForwarderActivity.java   | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/java/src/com/android/intentresolver/IntentForwarderActivity.java b/java/src/com/android/intentresolver/IntentForwarderActivity.java
index 2a957d6..40f71ab 100644
--- a/java/src/com/android/intentresolver/IntentForwarderActivity.java
+++ b/java/src/com/android/intentresolver/IntentForwarderActivity.java
@@ -431,8 +431,8 @@ public class IntentForwarderActivity extends Activity  {
         public CompletableFuture<ResolveInfo> resolveActivityAsUser(Intent intent,
                 String resolvedType, int flags, int userId) {
             return CompletableFuture.supplyAsync(
-                    () -> getPackageManager().resolveActivityAsUser(intent,
-                            resolvedType, flags, userId));
+                    // ponytail: UL frameworks/base lacks the resolvedType overload.
+                    () -> getPackageManager().resolveActivityAsUser(intent, flags, userId));
         }
 
         @Override
