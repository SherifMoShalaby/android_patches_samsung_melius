From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sherif Shalaby <sherif2222222@gmail.com>
Date: Wed, 14 Oct 2026 15:12:56 +0300
Subject: [PATCH 1/2] gd: hal: don't block on IBluetoothHci 1.1 when only 1.0
 is registered

getService() for 1.1 waits for a lazy start that never happens on devices with a
1.0 HAL, and the 500ms watchdog aborts com.android.bluetooth before the 1.0
fallback runs. tryGetService() returns immediately.
---
 system/gd/hal/hci_hal_android_hidl.cc | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/system/gd/hal/hci_hal_android_hidl.cc b/system/gd/hal/hci_hal_android_hidl.cc
index daef433..84e72d0 100644
--- a/system/gd/hal/hci_hal_android_hidl.cc
+++ b/system/gd/hal/hci_hal_android_hidl.cc
@@ -436,7 +436,7 @@ class HciHalHidl : public HciHal {
         }),
         std::chrono::milliseconds(500));
 
-    bt_hci_1_1_ = IBluetoothHci_1_1::getService();
+    bt_hci_1_1_ = IBluetoothHci_1_1::tryGetService();  // don't block on a 1.1 HAL that does not exist
 
     if (bt_hci_1_1_ != nullptr) {
       bt_hci_ = bt_hci_1_1_;
